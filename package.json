{
  "name": "hubfetch",
  "version": "0.3.0",
  "private": true,
  "description": "Unofficial Windows x64 desktop client for the Hugging Face Hub",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter hubfetch-desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "test:release-tools": "node --test .github/scripts/release-tools/release-tools.test.mjs",
    "test:no-updater": "node --test scripts/no-updater.test.mjs",
    "test:privileges": "node --test scripts/privilege-boundaries.test.mjs",
    "test:docs": "node --test scripts/docs-link-check.test.mjs scripts/docs-contract.test.mjs scripts/notices.test.mjs scripts/command-reference.test.mjs",
    "test:visual-tools": "node --test scripts/update-screenshots-baseline.test.mjs",
    "test:coverage": "pnpm --filter hubfetch-desktop test:coverage",
    "screenshots:update": "node scripts/update-screenshots-baseline.mjs",
    "verify:syntax-build": "node scripts/verify-syntax-build.mjs",
    "release:gates": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-quality-gates.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "release:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-portable.ps1",
    "release:policy": "node scripts/check-package-policy.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "i18n:extract": "pnpm --filter hubfetch-desktop i18n:extract",
    "i18n:check": "pnpm --filter hubfetch-desktop i18n:check",
    "postinstall": "node scripts/rebuild-native.mjs",
    "package:win": "pnpm --filter hubfetch-desktop package:win"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
